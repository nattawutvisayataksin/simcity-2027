{
  "servers": {
    "pixellab": {
      "url": "https://api.pixellab.ai/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${PIXELLAB_API_TOKEN}"
      }
    },
    "pixler": {
      "url": "https://mcp.pixler.dev",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${PIXLER_API_TOKEN}"
      }
    }
  }
}
